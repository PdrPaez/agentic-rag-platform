# Local defaults are offline-friendly. Copy this file to backend/.env only when customization is needed.
APP_NAME=Agentic RAG Platform API
APP_VERSION=0.1.0
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api
DATABASE_URL=sqlite:///./data/agentic_rag.db
MAX_UPLOAD_SIZE_BYTES=10485760
VECTOR_STORAGE_PATH=./qdrant_storage
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_COLLECTION_NAME=document_chunks
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
RETRIEVAL_CANDIDATE_COUNT=12
FINAL_CONTEXT_COUNT=5
LEXICAL_WEIGHT=0.4
VECTOR_WEIGHT=0.6
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CONTEXT_CHARACTERS=6000
